    "/api/kpi-summary": {
      "get": {
        "summary": "Kpi Summary",
        "operationId": "kpi_summary_api_kpi_summary_get",
        "parameters": [
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "カンマ区切りの店舗IDで絞り込み（例: S001,S002）。未指定なら全店舗。",
              "title": "Store Id"
            },
            "description": "カンマ区切りの店舗IDで絞り込み（例: S001,S002）。未指定なら全店舗。"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "集計期間の開始日（含む、YYYY-MM-DD）",
              "title": "Date From"
            },
            "description": "集計期間の開始日（含む、YYYY-MM-DD）"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "集計期間の終了日（含む、YYYY-MM-DD）",
              "title": "Date To"
            },
            "description": "集計期間の終了日（含む、YYYY-MM-DD）"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KpiSummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
