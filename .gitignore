# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / フロントエンドビルド成果物
frontend/node_modules/
# frontend/dist/ はGit管理対象とする（Databricks Reposでデプロイする場合、
# Reposはgit管理下のファイルしか同期しないため、ビルド成果物を含める必要がある。
# 本README 9節・18節「実装上の仮定」参照）

# 環境変数・秘密情報
.env
.env.*
!.env.example

# 実行時に生成される判断保存データ（デモセッションの状態。静的フィクスチャのdata/やartifacts/とは異なる）
runtime/

# エディタ・OS
.DS_Store
