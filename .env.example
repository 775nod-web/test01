# Local development only. Never commit a real .env file (see .gitignore).
# In deployed Databricks Apps, warehouse connection details are injected by
# attaching a SQL warehouse resource to the app — do not set them manually
# there.

# Databricks SQL warehouse connection (local dev against a real workspace)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Unity Catalog target
UC_CATALOG=bank_demo
UC_SCHEMA_GOLD=gold

# Local-only port (Databricks Apps supplies DATABRICKS_APP_PORT at runtime)
DATABRICKS_APP_PORT=8000
